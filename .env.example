# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Either an auth token grabbed from resy.com (see config.example.yaml) ...
RESY_AUTH_TOKEN=

# ... or your Resy login (leave the token blank if you use these).
RESY_EMAIL=
RESY_PASSWORD=

# Optional: a specific saved-card id to book with.
RESY_PAYMENT_METHOD_ID=

# Only needed if you enable email notifications.
SMTP_USER=
SMTP_PASS=
